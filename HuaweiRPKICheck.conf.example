# Example configuration file for HuaweiRPKICheck
# Copy this file to HuaweiRPKICheck.conf and update with your values
# Then encrypt it using HuaweiRPKI_credgen.py

hostname=192.168.1.1
username=admin
password=your_password_here
smtp_server=mail.example.com
smtp_port=587
smtp_username=rpki@example.com
smtp_password=smtp_password_here
email_sender=rpki@example.com
email_receiver=noc@example.com